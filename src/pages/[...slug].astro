---
// src/pages/[...slug].astro
import BlogLayout from '@/layouts/BlogLayout.astro';
import { getCollection, render } from 'astro:content';

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/404');
}

// Fetch every published English post on this request
const posts = await getCollection('blog', ({ data }) => {
  return data.locale === 'en' && (import.meta.env.PROD ? data.draft !== true : true);
});

// Match the requested slug against the post id (id looks like "en/my-post")
const post = posts.find((p) => p.id.replace('en/', '') === slug);

if (!post) {
  return Astro.redirect('/404');
}

const { Content } = await render(post);
---

<BlogLayout
  title={post.data.title}
  description={post.data.description}
  publishedAt={post.data.publishedAt}
  updatedAt={post.data.updatedAt}
  author={post.data.author}
  image={post.data.image}
  imageAlt={post.data.imageAlt}
  svgSlug={post.data.svgSlug}
  tags={post.data.tags}
  slug={post.id}
>
  <Content />
</BlogLayout>
