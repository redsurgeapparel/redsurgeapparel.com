---
// src/layouts/BlogLayout.astro
import siteConfig from '@/config/site.config';
import BaseLayout from './BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import Breadcrumbs from '@/components/seo/Breadcrumbs.astro';
import ArticleHero from '@/components/blog/ArticleHero.astro';
import ShareButtons from '@/components/blog/ShareButtons.astro';
import RelatedPosts from '@/components/blog/RelatedPosts.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import { resolveSocialLinks } from '@/lib/utils';
import { createBlogPostSchema, createFAQSchema } from '@/lib/schema';

const socialLinks = resolveSocialLinks(siteConfig.socialLinks);

interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  title: string;
  description: string;
  publishedAt: Date;
  updatedAt?: Date;
  author?: string;
  image?: string;
  imageAlt?: string;
  svgSlug?: string;
  tags?: string[];
  slug?: string;
  faqs?: FAQItem[];
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  publishedAt,
  updatedAt,
  author = 'Team',
  image,
  imageAlt,
  svgSlug,
  tags = [],
  slug = '',
  faqs,
  schema,
} = Astro.props;

const ogImage = image || siteConfig.ogImage;

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Blog', href: '/blog' },
  { label: title },
];

const siteUrl = Astro.site ?? new URL(siteConfig.url);
const cleanSlug = slug.replace(/^(en|es|fr)\//, '');
const canonicalUrl = new URL(cleanSlug ? `/${cleanSlug}` : Astro.url.pathname, siteUrl).toString();

const absoluteImage = (() => {
  if (!ogImage) return undefined;
  try {
    return new URL(ogImage, siteUrl).toString();
  } catch {
    return undefined;
  }
})();

const articleSchema = createBlogPostSchema({
  title,
  description,
  url: canonicalUrl,
  image: absoluteImage ?? '',
  datePublished: publishedAt,
  dateModified: updatedAt,
  author: {
    name: author,
    url: new URL('/about', siteUrl).toString(),
  },
});

const faqSchema = faqs && faqs.length > 0 ? createFAQSchema(faqs) : undefined;

const pageSchemas = [
  articleSchema,
  ...(faqSchema ? [faqSchema] : []),
  ...(schema ? (Array.isArray(schema) ? schema : [schema]) : []),
];

const fullUrl = canonicalUrl;
---

<BaseLayout
  title={title}
  description={description}
  image={ogImage}
  imageAlt={imageAlt || title}
  article={{
    publishedTime: publishedAt,
    modifiedTime: updatedAt,
    authors: [author],
    tags,
  }}
  includePersonSchema={true}
  schema={pageSchemas}
>
  <Header
    slot="header"
    position="fixed"
    shape="bar"
    variant="solid"
    size="lg"
    showCta={false}
    cta={{ label: 'Get in touch', href: '/contact' }}
    showScrollProgress
  />

  <div class="min-h-screen pt-16">
    <ArticleHero
      title={title}
      description={description}
      publishedAt={publishedAt}
      updatedAt={updatedAt}
      author={author}
      tags={tags}
      image={image}
      imageAlt={imageAlt}
      svgSlug={svgSlug}
    />

    <article class="pt-8">
      <div class="mx-auto max-w-4xl px-6">
        <Breadcrumbs items={breadcrumbs} class="mb-8" />

        <div
          class="mv-content-body prose prose-lg prose-headings:text-foreground prose-p:text-foreground prose-li:text-foreground max-w-none"
        >
          <slot />
        </div>

        <footer class="border-border mt-12 border-t pt-8">
          <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
            <a
              href="/blog"
              class="text-brand-600 hover:text-brand-500 dark:text-brand-400 dark:hover:text-brand-300 inline-flex items-center gap-2 text-sm font-medium transition-colors"
            >
              <svg
                class="h-4 w-4"
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"
                ></path>
              </svg>
              Back to Blog
            </a>
            <ShareButtons title={title} url={fullUrl} />
          </div>
        </footer>
      </div>
    </article>

    <!-- Related Posts -->
    {
      tags.length > 0 && (
        <div class="mx-auto mt-16 max-w-4xl px-6">
          <RelatedPosts currentSlug={slug} tags={tags} locale="en" maxPosts={3} />
        </div>
      )
    }

    <!-- Follow Along (Replaced Astro Rocket <CTA> component with raw HTML to prevent color conflicts) -->
    <div class="border-border mx-auto mt-10 mb-16 max-w-4xl border-t px-6 pt-16 text-center">
      <h2 class="text-foreground text-3xl font-bold md:text-4xl">
        Get new outfit guides as they publish
      </h2>
      <p class="text-foreground-muted mx-auto mt-4 max-w-2xl text-lg">
        Concert outfit formulas, styling tips, and new guides — follow along however you prefer.
      </p>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a
          href="/rss.xml"
          class="border-border bg-background text-foreground hover:border-brand-500 hover:text-brand-500 inline-flex items-center gap-2 rounded-full border px-4 py-2 text-sm font-medium transition-colors"
        >
          <Icon name="rss" size="sm" /> RSS Feed
        </a>
        {
          socialLinks.map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="border-border bg-background text-foreground hover:border-brand-500 hover:text-brand-500 inline-flex items-center gap-2 rounded-full border px-4 py-2 text-sm font-medium transition-colors"
            >
              <Icon name={link.icon} size="sm" /> {link.label}
            </a>
          ))
        }
        <a
          href={`mailto:${siteConfig.email}`}
          class="border-border bg-background text-foreground hover:border-brand-500 hover:text-brand-500 inline-flex items-center gap-2 rounded-full border px-4 py-2 text-sm font-medium transition-colors"
        >
          <Icon name="mail" size="sm" /> Email
        </a>
      </div>
    </div>
  </div>

  <Footer slot="footer" layout="simple" background="secondary" />
</BaseLayout>
